# =================================================================
# GreenRouting API - Environment Configuration Template
# =================================================================
# INSTRUCTIONS: 
# 1. Copy this file and rename it to '.env'
# 2. Fill in your local secret keys below.
# 3. DO NOT commit your actual '.env' file to GitHub.
# =================================================================

# AWS ACCESS CREDENTIALS
# These allow the Boto3 SDK to communicate with Amazon Bedrock and DynamoDB.
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1

# AMAZON NOVA MODEL IDS
# These specific IDs ensure we are calling the correct Nova 2 foundation models.
NOVA_LITE_ID=us.amazon.nova-lite-v1:0
NOVA_PRO_ID=us.amazon.nova-pro-v1:0
NOVA_EMBED_ID=amazon.nova-embeddings-v1

# EXTERNAL SUSTAINABILITY APIS
# Register at electricitymaps.com to get your API key for regional carbon data.
EMAPS_API_KEY=your_electricity_maps_api_key_here

# PROJECT SPECIFIC SETTINGS
# Complexity threshold for routing (0.0 to 1.0). Higher = More Lite usage.
COMPLEXITY_THRESHOLD=0.65
DYNAMODB_TABLE_NAME=GreenRoutingLogs
